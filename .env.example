# Copy this file to .env and fill in your own values. Never commit .env.

# true = canned replies, no API calls, no cost. Set to false to use Gemini.
USE_FAKE_AI=true

# Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Check Google AI Studio for the current cheapest model name if this one stops working.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional anonymous play storage (leave empty to turn it off).
SUPABASE_URL=
# Supabase publishable (anon) key, insert only.
SUPABASE_KEY=
