# Copy this file to .env and fill in your own values. Never commit .env.

# true = canned replies, no API calls, no cost. Set to false to use Gemini.
USE_FAKE_AI=true

# Get a key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional. Leave empty to use the built-in list of models (engine/ai.py MODEL_CANDIDATES).
# A model set here is tried first; if it is missing or overloaded the game moves on to the list.
GEMINI_MODEL=

# Optional anonymous play storage (leave empty to turn it off).
SUPABASE_URL=
# Supabase publishable (anon) key, insert only.
SUPABASE_KEY=
